# 운영 서버용 .env 예시. 복사해 .env 로 저장하고 값을 채운다. .env 는 Git에 올리지 않는다.
# 비밀값은 영문·숫자만 사용한다(DB URL에 그대로 들어간다).
#   PowerShell 생성 예: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 40 | % {[char]$_})

# 접속 주소(서버 PC의 고정 IP 또는 사내 DNS 이름). 쉼표로 여러 개 지정 가능
AUTOTEST_SITE_ADDRESS=192.168.0.10
# AUTOTEST_HTTPS_PORT=443
# AUTOTEST_HTTP_PORT=80

# DB 계정. 기존 볼륨을 이어 쓰면 비밀번호 변경 절차를 먼저 수행한다(docs/PRODUCTION_DEPLOYMENT.md).
DB_USER=test
DB_PASSWORD=

# SeaweedFS(S3)
S3_ACCESS_KEY=
S3_SECRET_KEY=

# 서비스 간 내부 API 토큰
PRODUCT_DESCRIPTION_INTERNAL_TOKEN=

# 외부 판정(Jev/TypeSafe) — 비우면 규칙 검사만으로 진행
TYPESAFE_API_KEY=

# LLM
LLM_MODE=real
LLM_PROVIDER=ollama
LLM_MODEL=
EX_API=
EXECUTION_QWEN_MODEL=qwen3.8:27b
# ollama-init 이 준비할 모델(공백 구분). manual-review 를 쓰면 qwen3:4b 추가
OLLAMA_MODELS=qwen3.8:27b
# Authentication: generate a random secret (at least 32 bytes), shared by auth and gateway.
AUTH_JWT_SECRET=
# Required on first start only. Existing admin credentials are never overwritten.
AUTH_BOOTSTRAP_ADMIN_USERNAME=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
AUTH_BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
# Production override enforces true; false is only for local HTTP development.
AUTH_COOKIE_SECURE=true
